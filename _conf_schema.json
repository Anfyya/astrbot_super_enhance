{
    "life_state": {
        "description": "① 世界线（她们每天的日子）",
        "type": "object",
        "hint": "记录员把聊天里发生的事记进世界线，没人聊天时补写把接下来的空档一段段补上；她们聊天、主动找主人时都带着世界线。每个机器人一条线，网页「上下文」页能看能改。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "hint": "总开关，关了这一组都不起作用。",
                "default": true
            },
            "world_mode": {
                "description": "模式",
                "type": "string",
                "hint": "平时用「开启」。另外两种是旧的每日日程架构，只为退回去留着。",
                "options": [
                    "live",
                    "shadow",
                    "off"
                ],
                "labels": [
                    "开启",
                    "只记录，聊天还用旧日程",
                    "关闭，用旧的每日日程"
                ],
                "condition": {
                    "enabled": true
                },
                "default": "live"
            },
            "bot_labels": {
                "description": "机器人名字",
                "type": "string",
                "hint": "写成 napcat=丛雨,napcat2=亚托莉。世界线、网页、提示词里都用这个名字。",
                "condition": {
                    "enabled": true
                },
                "default": "napcat=丛雨,napcat2=亚托莉"
            },
            "session_list_mode": {
                "description": "管哪些机器人",
                "type": "string",
                "options": [
                    "whitelist",
                    "blacklist",
                    "none"
                ],
                "labels": [
                    "只管名单里的",
                    "名单里的不管",
                    "存过世界线的都管"
                ],
                "condition": {
                    "enabled": true
                },
                "default": "whitelist"
            },
            "session_list": {
                "description": "机器人名单",
                "type": "list",
                "hint": "填机器人 id（napcat、napcat2），填会话号也行，只看开头那段。一个机器人的所有会话共用一条世界线。",
                "items": {
                    "type": "string"
                },
                "condition": {
                    "enabled": true
                },
                "default": []
            },
            "timezone": {
                "description": "时区",
                "type": "string",
                "hint": "留空用 AstrBot 的全局时区，没设就是 Asia/Shanghai。",
                "condition": {
                    "enabled": true
                },
                "default": ""
            },
            "models": {
                "description": "模型",
                "type": "object",
                "hint": "记录员和补写调模型时用。",
                "condition": {
                    "enabled": true
                },
                "items": {
                    "llm_provider_id": {
                        "description": "用哪个模型",
                        "type": "string",
                        "_special": "select_provider",
                        "hint": "留空用 AstrBot 的默认模型。",
                        "default": "opencodeGO/deepseek-v4.1-flash"
                    },
                    "world_llm_timeout": {
                        "description": "最多等几秒",
                        "type": "int",
                        "obvious_hint": true,
                        "hint": "补写一次要想五六分钟，别低于 600。",
                        "default": 600
                    },
                    "persona_id": {
                        "description": "补写用的人格",
                        "type": "string",
                        "_special": "select_persona",
                        "hint": "留空（推荐）：每个机器人用自己的默认人格。填了两个机器人都用这一份。",
                        "default": ""
                    }
                }
            },
            "story": {
                "description": "故事设定",
                "type": "object",
                "hint": "记录员和补写都照着写。",
                "condition": {
                    "enabled": true
                },
                "items": {
                    "world_home": {
                        "description": "住在哪",
                        "type": "string",
                        "hint": "补写写的地方和活动都在这一带，人设里别的地方只当背景。",
                        "default": "穗织"
                    },
                    "world_notes": {
                        "description": "固定事实",
                        "type": "text",
                        "hint": "一行一条（哪里在哪、哪扇门关着）。剧情变了改这里。",
                        "default": "藏经阁的门是关着的：里面的人不主动出来，外面的人看不见里面在做什么，不要写谁打那儿过瞧见里面。\n藏经阁不在神社里，是两处地方。"
                    }
                }
            },
            "recorder": {
                "description": "记录员",
                "type": "object",
                "hint": "一段对话停下来以后，把里面发生的事记进世界线。",
                "condition": {
                    "enabled": true
                },
                "items": {
                    "recorder_quiet_seconds": {
                        "description": "停多久开始记（秒）",
                        "type": "int",
                        "hint": "一个会话最后一条消息过了这么久没有新的，就把这段记下来。",
                        "slider": {
                            "min": 10,
                            "max": 600,
                            "step": 10
                        },
                        "default": 60
                    },
                    "recorder_batch": {
                        "description": "一次最多读几条",
                        "type": "int",
                        "slider": {
                            "min": 10,
                            "max": 200,
                            "step": 10
                        },
                        "default": 60
                    },
                    "raw_log_enabled": {
                        "description": "另存一份原始消息",
                        "type": "bool",
                        "obvious_hint": true,
                        "hint": "记录员靠它读聊天原文，主动消息也要用，只留今天和昨天。世界线开着就别关。",
                        "default": true
                    }
                }
            },
            "step": {
                "description": "补写",
                "type": "object",
                "hint": "没人聊天时，把接下来几小时的事一段段写进世界线。",
                "condition": {
                    "enabled": true
                },
                "items": {
                    "world_enabled": {
                        "description": "启用补写",
                        "type": "bool",
                        "hint": "关了就只有记录员在记。",
                        "default": true
                    },
                    "step_lead_minutes": {
                        "description": "提前几分钟写下一段",
                        "type": "int",
                        "hint": "手上那件事快做完时，提前这么多分钟写下一段。",
                        "slider": {
                            "min": 1,
                            "max": 30,
                            "step": 1
                        },
                        "condition": {
                            "world_enabled": true
                        },
                        "default": 5
                    },
                    "step_window_hours": {
                        "description": "断档最多补几小时",
                        "type": "int",
                        "hint": "停机、出错断了很久时，最多往回补这么多，更早的不补。",
                        "slider": {
                            "min": 1,
                            "max": 12,
                            "step": 1
                        },
                        "condition": {
                            "world_enabled": true
                        },
                        "default": 3
                    }
                }
            },
            "injection": {
                "description": "聊天时给她看的",
                "type": "object",
                "hint": "和主人聊天、主动发消息时附上的世界线块里放什么。",
                "condition": {
                    "enabled": true
                },
                "items": {
                    "world_inject_recent": {
                        "description": "放今天最近几条",
                        "type": "int",
                        "slider": {
                            "min": 2,
                            "max": 40,
                            "step": 1
                        },
                        "default": 12
                    },
                    "world_no_repeat": {
                        "description": "别每句都说手上在干嘛",
                        "type": "bool",
                        "hint": "块尾加一句：主人问起、或者正好相关时再说。",
                        "default": true
                    },
                    "world_voice_note": {
                        "description": "别当管家厨娘",
                        "type": "bool",
                        "hint": "块尾再加一句：没问就别报菜单、碗洗没洗，照自己的性子说；主动消息另加一句别报家务清单。",
                        "default": true
                    },
                    "abilities_enabled": {
                        "description": "能力清单和在练的事",
                        "type": "bool",
                        "hint": "她后来学会的、正在练的事一起带上。在网页「能力与约定」里改。",
                        "default": true
                    },
                    "promise_enabled": {
                        "description": "约定",
                        "type": "bool",
                        "hint": "带上接下来 7 天的约定，到点主动提起。在网页「能力与约定」里改。",
                        "default": true
                    },
                    "injection_mode": {
                        "description": "怎么交给模型",
                        "type": "string",
                        "hint": "一般不用改。",
                        "options": [
                            "extra_user_content_parts",
                            "fake_tool_call"
                        ],
                        "labels": [
                            "附在主人这条消息后面",
                            "装成一次工具调用的结果"
                        ],
                        "default": "extra_user_content_parts"
                    }
                }
            },
            "proactive": {
                "description": "主动找主人说话",
                "type": "object",
                "hint": "早安、晚安、约定到点、做完一件事时，她会主动给主人发消息。",
                "condition": {
                    "enabled": true
                },
                "items": {
                    "proactive_enable": {
                        "description": "启用",
                        "type": "bool",
                        "hint": "主人 5 分钟内说过话就往后推；发不发、怎么说她自己看着办。",
                        "default": true
                    },
                    "proactive_targets": {
                        "description": "发到哪个会话",
                        "type": "list",
                        "hint": "填完整会话号（napcat:FriendMessage:QQ号）。哪个机器人这里没填，就用上面名单里它的会话；都没有就不给它排。",
                        "items": {
                            "type": "string"
                        },
                        "condition": {
                            "proactive_enable": true
                        },
                        "default": []
                    },
                    "proactive_done_min_importance": {
                        "description": "做完多大的事才说",
                        "type": "int",
                        "hint": "补写给每段事打 1–5 分（1 洗碗走路，3 逛街泡脚，4 修好东西、碰上新鲜事，5 练成一招、碰上意外），够这个分才叫她说。出门、到家、开饭那一刻总会叫一次。",
                        "slider": {
                            "min": 1,
                            "max": 5,
                            "step": 1
                        },
                        "condition": {
                            "proactive_enable": true
                        },
                        "default": 3
                    },
                    "proactive_extra_requirements": {
                        "description": "额外要求",
                        "type": "text",
                        "hint": "附在每次主动消息提示词的最后，留空不加。",
                        "condition": {
                            "proactive_enable": true
                        },
                        "default": ""
                    }
                }
            },
            "other": {
                "description": "其它",
                "type": "object",
                "condition": {
                    "enabled": true
                },
                "items": {
                    "world_keep_days": {
                        "description": "世界线留几天",
                        "type": "int",
                        "hint": "更早的那几天自动删掉。",
                        "default": 30
                    },
                    "edit_tool_enabled": {
                        "description": "改日程工具",
                        "type": "bool",
                        "hint": "旧的每日日程才用：给她 revise_life_state 改自己的日程。世界线开启时不给。",
                        "default": true
                    },
                    "debug": {
                        "description": "调试日志",
                        "type": "bool",
                        "default": false
                    }
                }
            }
        }
    },
    "history_transcript": {
        "description": "② 历史写成聊天记录",
        "type": "object",
        "hint": "发给模型时，会话历史不再当成她自己一条条说过的话，而是写成系统提示里一段带时间的「最近的聊天记录」，免得她照着自己前几条的口气往下接。思考和工具调用不写（画图的两个工具例外）；只改发出去的那一份，存着的历史不动。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "hint": "关了回到 AstrBot 原来的发法：历史全量当消息发。",
                "default": true
            },
            "recent_messages": {
                "description": "放最近几条原话",
                "type": "int",
                "hint": "只数主人和她有正文的消息。0 = 前情备忘之后的原话全放。",
                "slider": {
                    "min": 0,
                    "max": 200,
                    "step": 1
                },
                "condition": {
                    "enabled": true
                },
                "default": 0
            },
            "include_memo": {
                "description": "带上前情备忘",
                "type": "bool",
                "hint": "会话开头有 /compact v2 写的备忘时，放在聊天记录前面。",
                "condition": {
                    "enabled": true
                },
                "default": true
            },
            "sessions": {
                "description": "只管这些会话",
                "type": "list",
                "hint": "填会话号，一行一个；不填 = 开了世界线的机器人的所有私聊。",
                "condition": {
                    "enabled": true
                },
                "default": []
            }
        }
    },
    "cron_context": {
        "description": "③ 主动消息只带最近的聊天",
        "type": "object",
        "hint": "她主动找主人说话时，只把最近一段的聊天正文交给模型（不带思考和工具调用），省 token。平时聊天不受影响，存着的历史不改。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "hint": "关了主动消息带全部历史。",
                "default": true
            },
            "window_hours": {
                "description": "带最近几小时",
                "type": "int",
                "hint": "从最后一条消息往前数。前情备忘一直带着。",
                "slider": {
                    "min": 1,
                    "max": 168,
                    "step": 1
                },
                "condition": {
                    "enabled": true
                },
                "default": 24
            },
            "max_messages": {
                "description": "最多几条",
                "type": "int",
                "hint": "超过就只留最近这么多条；历史里认不出时间时也按它裁。",
                "slider": {
                    "min": 10,
                    "max": 1000,
                    "step": 10
                },
                "condition": {
                    "enabled": true
                },
                "default": 200
            },
            "notify_errors": {
                "description": "出错时说一声",
                "type": "bool",
                "hint": "裁剪出错时在会话里说一声，用「出错时她说的话」里那组句子，没配句子就发原因。",
                "condition": {
                    "enabled": true
                },
                "default": true
            }
        }
    },
    "context_tools": {
        "description": "④ 上下文命令（/usage、/compact）",
        "type": "object",
        "hint": "/usage 看上下文占了多少；/compact 只去掉思考和工具结果、原话全留；/compact v2 写前情备忘、挑原话摘录。命令只有管理员能用。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "hint": "管这几个命令和「上下文满了」。每天自动压缩有自己的开关，不受它管。",
                "default": true
            },
            "compact_v2": {
                "description": "/compact v2",
                "type": "object",
                "hint": "/compact v2 [12m|12h|1d] [临时要求] 出预览；/compact v2 continue 意见 接着改；/compact v2 enter 写入；/compact v2 undo 撤销。不写保留多少就留今天和昨天的原话。",
                "items": {
                    "v2_provider_id": {
                        "description": "用哪个模型",
                        "type": "string",
                        "_special": "select_provider",
                        "hint": "要 OpenAI 兼容接口，只用来写备忘、挑摘录。",
                        "default": "opencodeGO/deepseek-v4.1-flash"
                    },
                    "v2_reasoning_effort": {
                        "description": "思考强度",
                        "type": "string",
                        "hint": "原样作为 reasoning_effort 传给模型，留空不传。",
                        "default": "high"
                    },
                    "v2_max_tokens": {
                        "description": "输出上限（含思考）",
                        "type": "int",
                        "hint": "思考很吃 token，上限小了会被思考耗光、写不出备忘。0 = 不传。",
                        "default": 200000
                    },
                    "v2_master_name": {
                        "description": "主人叫什么",
                        "type": "string",
                        "hint": "备忘里这么称呼主人。",
                        "default": "Ginka"
                    }
                }
            },
            "daily": {
                "description": "每天 0 点自动压缩",
                "type": "object",
                "items": {
                    "v2_daily": {
                        "description": "启用",
                        "type": "bool",
                        "hint": "0 点自动跑一次 /compact v2，不出预览直接写入，写前整份备份（/compact v2 undo 能撤）。停机错过了启动后补跑，失败了 15 分钟后再试。",
                        "default": false
                    },
                    "v2_daily_keep": {
                        "description": "保留多少原话",
                        "type": "string",
                        "hint": "写法同 /compact v2：12m 最近 12 条，12h 最近 12 小时，1d 今天。",
                        "condition": {
                            "v2_daily": true
                        },
                        "default": "12m"
                    },
                    "v2_daily_sessions": {
                        "description": "压缩哪些会话",
                        "type": "list",
                        "hint": "填会话号，一行一个；不填就不压缩。",
                        "condition": {
                            "v2_daily": true
                        },
                        "default": []
                    }
                }
            },
            "overflow": {
                "description": "上下文满了",
                "type": "object",
                "condition": {
                    "enabled": true
                },
                "items": {
                    "overflow_guard": {
                        "description": "不让 AstrBot 自动压缩",
                        "type": "bool",
                        "hint": "到了自动压缩线（/usage 里的 compress_at）不压缩、不调模型，只发下面那句提醒主人 /compact v2（不进历史）；主动消息照常发。关掉回到 AstrBot 原来的做法。",
                        "default": true
                    },
                    "overflow_replies": {
                        "description": "提醒的话",
                        "type": "list",
                        "hint": "每行「机器人id=句子」（napcat=丛雨，napcat2=亚托莉）。没配的发「（上下文满了，请主人手动 /compact v2）」。",
                        "condition": {
                            "overflow_guard": true
                        },
                        "default": [
                            "napcat=唔……本座脑子里塞得太满，一时理不清了。主人，先替本座收拾收拾罢。",
                            "napcat2=呜……亚托莉的记忆体塞满了，反应不过来了……高性能也是有极限的嘛，主人帮亚托莉整理一下好不好？"
                        ]
                    }
                }
            }
        }
    },
    "request_snapshot": {
        "description": "⑤ 真实请求快照",
        "type": "object",
        "hint": "把每次真正发给模型的东西整份存下来（系统提示、注入、工具、全部消息），网页「上下文」页切到「真实请求」能看。只留最近 20 份。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "hint": "关了就不再存，网页里「真实请求」是空的。",
                "default": true
            }
        }
    },
    "zero_think_retry": {
        "description": "⑥ 没思考就重来",
        "type": "object",
        "hint": "DeepSeek 偶尔一个字不想就回话，回得发飘。开着时，和主人聊天、主动消息拿到没思考的回复就不发、不存，同样的请求再要一次。记录员、补写、记忆总结不管。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
            },
            "max_retries": {
                "description": "最多重来几次",
                "type": "int",
                "hint": "都没想就用最后那次。",
                "slider": {
                    "min": 0,
                    "max": 5,
                    "step": 1
                },
                "condition": {
                    "enabled": true
                },
                "default": 2
            },
            "providers": {
                "description": "只管这些模型",
                "type": "list",
                "hint": "源编号或模型名里带这些字的才管，一行一个。",
                "condition": {
                    "enabled": true
                },
                "default": [
                    "deepseek"
                ]
            }
        }
    },
    "reply_guard": {
        "description": "⑦ 新消息优先",
        "type": "object",
        "hint": "她的回复还没发出去，主人又来了一条：丢掉上一轮（不发、不进历史），两条消息各带各的时间，一起重新回。面板里的网页聊天不管。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "hint": "关了回到 AstrBot 原来的做法（另起一轮，或者并进正在回的那一轮）。",
                "default": true
            }
        }
    },
    "error_voice": {
        "description": "⑧ 出错时她说的话",
        "type": "object",
        "hint": "AstrBot 和插件的报错原文换成她自己的口气说，出了什么错只进日志。每行「机器人id=句子」（napcat=丛雨，napcat2=亚托莉），一个机器人写几行就随机挑一句；没配的照旧发原来的报错。",
        "items": {
            "error_replies_model": {
                "description": "聊天时模型出错",
                "type": "list",
                "hint": "替掉「LLM 响应错误: …」。人格里自己配了报错的，用人格里那句。",
                "default": [
