{
    "basic": {
        "description": "基本信息",
        "type": "object",
        "hint": "各功能共用。世界设定、角色台词、运行参数和内部功能开关在插件网页的「设置」页。",
        "items": {
            "bot_identities": {
                "description": "机器人身份",
                "type": "list",
                "items": {
                    "type": "string"
                },
                "hint": "每行一个，格式：平台 ID=QQ 号=角色名，例如 napcat=123456789=丛雨。",
                "default": []
            },
            "master_ids": {
                "description": "主人 QQ",
                "type": "list",
                "items": {
                    "type": "string"
                },
                "hint": "每行一个。",
                "default": []
            },
            "master_name": {
                "description": "主人称呼",
                "type": "string",
                "hint": "整理聊天记录时对主人的称呼。",
                "default": "主人"
            },
            "timezone": {
                "description": "时区",
                "type": "string",
                "hint": "IANA 时区名，例如 Asia/Shanghai；留空使用 AstrBot 全局时区。",
                "default": ""
            },
            "debug": {
                "description": "调试日志",
                "type": "bool",
                "hint": "输出更详细的日志，排查问题时开启。",
                "default": false
            }
        }
    },
    "life_state": {
        "description": "世界线",
        "type": "object",
        "hint": "记录员从聊天里整理角色做过的事，补写安排接下来的日常；聊天时附上角色当下的状态。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
            },
            "session_list": {
                "description": "启用的机器人",
                "type": "list",
                "items": {
                    "type": "string"
                },
                "hint": "填平台 ID（如 napcat）或会话号；同一个机器人的所有会话共用一条世界线。",
                "condition": {
                    "enabled": true
                },
                "default": []
            },
            "llm_provider_id": {
                "description": "记录员与补写模型",
                "type": "string",
                "_special": "select_provider",
                "hint": "留空使用 AstrBot 默认模型。",
                "condition": {
                    "enabled": true
                },
                "default": ""
            },
            "proactive": {
                "description": "主动消息",
                "type": "object",
                "hint": "到点、做完事情、有约定时，角色主动给主人发消息。",
                "items": {
                    "proactive_enable": {
                        "description": "启用",
                        "type": "bool",
                        "default": true
                    },
                    "proactive_targets": {
                        "description": "发送会话",
                        "type": "list",
                        "items": {
                            "type": "string"
                        },
                        "hint": "填完整会话号，如 napcat:FriendMessage:QQ 号；没填的机器人发到它在上方名单里的会话。",
                        "condition": {
                            "proactive_enable": true
                        },
                        "default": []
                    }
                }
            }
        }
    },
    "context_tools": {
        "description": "上下文压缩",
        "type": "object",
        "hint": "/compact v2 写前情备忘并保留原话摘录，/usage 查看上下文占用；命令仅管理员可用。",
        "items": {
            "v2_provider_id": {
                "description": "压缩模型",
                "type": "string",
                "_special": "select_provider",
                "hint": "需要 OpenAI 兼容接口。",
                "default": ""
            },
            "v2_reasoning_effort": {
                "description": "思考强度",
                "type": "string",
                "hint": "作为 reasoning_effort 传给模型（low、medium、high），留空不传。",
                "default": "high"
            },
            "daily": {
                "description": "每日自动压缩",
                "type": "object",
                "hint": "每天 0 点自动执行一次 /compact v2：直接写入，写入前整份备份，可用 /compact v2 undo 撤销；错过的会在启动后补执行。",
                "items": {
                    "v2_daily": {
                        "description": "启用",
                        "type": "bool",
                        "default": false
                    },
                    "v2_daily_keep": {
                        "description": "保留原文",
                        "type": "string",
                        "hint": "格式同 /compact v2：12m 为最近 12 条，12h 为最近 12 小时，1d 为今天。",
                        "condition": {
                            "v2_daily": true
                        },
                        "default": "12m"
                    },
                    "v2_daily_sessions": {
                        "description": "压缩的会话",
                        "type": "list",
                        "items": {
                            "type": "string"
                        },
                        "hint": "每行一个会话号；留空不压缩。",
                        "condition": {
                            "v2_daily": true
                        },
                        "default": []
                    }
                }
            }
        }
    },
    "image_gen": {
        "description": "画面呈现",
        "type": "object",
        "hint": "提供 show_view、send_view 工具：先呈现画面给角色自己看，满意后再发出。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
            },
            "provider_id": {
                "description": "图像模型",
                "type": "string",
                "_special": "select_provider",
                "hint": "需要 OpenAI 兼容接口。角色参考图放在插件数据目录 images/refs/<角色名>.png。",
                "condition": {
                    "enabled": true
                },
                "default": ""
            },
            "fallback_provider_ids": {
                "description": "备用图像模型",
                "type": "list",
                "items": {
                    "type": "string"
                },
                "_special": "select_providers",
                "hint": "主模型失败、超时或没有出图时，按顺序换用。",
                "condition": {
                    "enabled": true
                },
                "default": []
            }
        }
    },
    "bot_dialog": {
        "description": "角色互聊",
        "type": "object",
        "hint": "两个角色互相发消息时限制来回次数，避免一直接话。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
            },
            "max_rounds": {
                "description": "最多来回",
                "type": "int",
                "slider": {
                    "min": 1,
                    "max": 10,
                    "step": 1
                },
                "hint": "超过后不再回复。",
                "condition": {
                    "enabled": true
                },
                "default": 3
            }
        }
    },
    "typing": {
        "description": "输入状态",
        "type": "object",
        "hint": "回复发出前，在 QQ 私聊里显示「对方正在输入…」。",
        "items": {
            "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
            }
        }
    }
}
